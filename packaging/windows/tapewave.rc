#include <windows.h>

1 ICON "icons/icon.ico"
1 RT_MANIFEST "packaging/windows/tapewave.manifest"

1 VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Tapewave - Native Windows Audio Player\0"
      VALUE "FileVersion", "0.2.0\0"
      VALUE "InternalName", "tapewave\0"
      VALUE "OriginalFilename", "tapewave.exe\0"
      VALUE "ProductName", "Tapewave\0"
      VALUE "ProductVersion", "0.2.0\0"
      VALUE "LegalCopyright", "MIT License\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
