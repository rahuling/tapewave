{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tapedeck",
  "version": "0.1.0",
  "identifier": "dev.tapedeck.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Tapedeck",
        "width": 420,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
